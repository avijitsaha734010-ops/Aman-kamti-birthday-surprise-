<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<meta name="theme-color" content="#0b1030">
<title>Happy Birthday Aman Kamti!</title>
<style>
/* =========================================================
   DESIGN TOKENS
   ========================================================= */
:root{
  --navy-950:#060924;
  --navy-900:#0b1030;
  --navy-800:#141a4a;
  --purple:#7c3aed;
  --purple-soft:#a78bfa;
  --pink:#ff4fa3;
  --pink-soft:#ff9ccf;
  --gold:#f5c76b;
  --gold-deep:#d9a441;
  --text:#f6f3ff;
  --text-dim:#cfc8ee;
  --glass:rgba(255,255,255,.07);
  --glass-border:rgba(255,255,255,.16);
  --shadow:0 20px 60px rgba(0,0,0,.45);
  --serif:'Palatino Linotype','Book Antiqua',Palatino,Georgia,'Times New Roman',serif;
  --script:'Segoe Script','Brush Script MT','Snell Roundhand',cursive;
  --sans:system-ui,-apple-system,'Segoe UI',Roboto,'Helvetica Neue',Arial,sans-serif;
}

/* =========================================================
   BASE
   ========================================================= */
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
html{scroll-behavior:smooth;-webkit-text-size-adjust:100%}
body{
  font-family:var(--sans);
  color:var(--text);
  background:
    radial-gradient(1200px 700px at 15% -10%,rgba(124,58,237,.35),transparent 60%),
    radial-gradient(900px 600px at 100% 10%,rgba(255,79,163,.22),transparent 60%),
    linear-gradient(180deg,var(--navy-900),var(--navy-950) 70%);
  background-attachment:fixed;
  min-height:100vh;
  overflow-x:hidden;
  line-height:1.6;
}
body.locked{overflow:hidden}
button{font:inherit;color:inherit;cursor:pointer;border:0;background:none;-webkit-tap-highlight-color:transparent}
:focus-visible{outline:3px solid var(--gold);outline-offset:3px;border-radius:12px}
.sr-only{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap}

/* =========================================================
   BACKGROUND LAYERS (stars, balloons, hearts, confetti)
   ========================================================= */
.fx{position:fixed;inset:0;overflow:hidden;pointer-events:none}
#stars{z-index:0}
#balloons{z-index:1}
#hearts{z-index:1}
#confetti{position:fixed;inset:0;width:100%;height:100%;z-index:60;pointer-events:none}

.star{
  position:absolute;border-radius:50%;background:#fff;
  width:var(--s);height:var(--s);left:var(--x);top:var(--y);
  box-shadow:0 0 6px 1px rgba(255,255,255,.7);
  opacity:.2;animation:twinkle var(--t) ease-in-out var(--d) infinite;
}
@keyframes twinkle{0%,100%{opacity:.15;transform:scale(.8)}50%{opacity:1;transform:scale(1.25)}}

.balloon{
  position:absolute;left:var(--x);bottom:-200px;
  width:var(--s);height:calc(var(--s)*1.22);
  border-radius:50% 50% 50% 50%/46% 46% 54% 54%;
  background:radial-gradient(circle at 30% 28%,rgba(255,255,255,.6),rgba(255,255,255,0) 35%),var(--c);
  box-shadow:inset -8px -10px 18px rgba(0,0,0,.22),0 0 24px var(--c);
  opacity:.8;will-change:transform;
  animation:rise var(--t) linear var(--d) infinite;
}
.balloon::before{ /* knot */
  content:"";position:absolute;left:50%;bottom:-6px;width:10px;height:10px;
  background:var(--c);transform:translateX(-50%) rotate(45deg);border-radius:2px;
}
.balloon::after{ /* string */
  content:"";position:absolute;left:50%;top:100%;width:1px;height:60px;
  background:linear-gradient(rgba(255,255,255,.55),transparent);
}
@keyframes rise{
  0%{transform:translate3d(0,0,0) rotate(-4deg)}
  50%{transform:translate3d(24px,-65vh,0) rotate(4deg)}
  100%{transform:translate3d(-14px,-135vh,0) rotate(-4deg)}
}

.heart{
  position:absolute;left:var(--x);bottom:-40px;font-size:var(--s);
  opacity:0;will-change:transform,opacity;
  filter:drop-shadow(0 0 8px rgba(255,79,163,.7));
  animation:heartFloat var(--t) ease-in var(--d) infinite;
}
@keyframes heartFloat{
  0%{transform:translate3d(0,0,0) scale(.7);opacity:0}
  15%{opacity:.7}
  100%{transform:translate3d(30px,-110vh,0) scale(1.1);opacity:0}
}

/* =========================================================
   WELCOME SCREEN
   ========================================================= */
.welcome{
  position:fixed;inset:0;z-index:40;
  display:flex;align-items:center;justify-content:center;
  padding:max(24px,env(safe-area-inset-top)) 22px max(24px,env(safe-area-inset-bottom));
  text-align:center;
  background:
    radial-gradient(800px 500px at 50% 30%,rgba(124,58,237,.35),transparent 65%),
    linear-gradient(180deg,rgba(11,16,48,.55),rgba(6,9,36,.85));
  transition:opacity .8s ease,transform .8s ease,visibility .8s;
}
.welcome.leaving{opacity:0;transform:scale(1.04);visibility:hidden}
.welcome-inner{max-width:760px}
.eyebrow{
  display:inline-block;font-size:clamp(.78rem,2.6vw,.95rem);letter-spacing:.32em;text-transform:uppercase;
  color:var(--gold);padding:.55em 1.2em;border:1px solid rgba(245,199,107,.4);border-radius:999px;
  background:rgba(245,199,107,.08);
  opacity:0;animation:fadeUp .9s ease .2s forwards;
}
.welcome h1{
  margin:28px 0 14px;font-family:var(--serif);font-weight:700;
  font-size:clamp(2.3rem,9vw,5.2rem);line-height:1.1;
  background:linear-gradient(100deg,#fff 0%,var(--gold) 35%,var(--pink-soft) 70%,#fff 100%);
  background-size:200% auto;-webkit-background-clip:text;background-clip:text;
  -webkit-text-fill-color:transparent;color:transparent;
  animation:shine 6s linear infinite;
  text-shadow:0 0 40px rgba(255,79,163,.25);
}
.welcome h1 .ch{
  display:inline-block;opacity:0;transform:translateY(40px) scale(.8);
  animation:charIn .7s cubic-bezier(.2,.9,.3,1.3) forwards;
  animation-delay:calc(.5s + var(--i)*.045s);
}
.welcome h1 .sp{display:inline-block;width:.28em}
@keyframes charIn{to{opacity:1;transform:none}}
@keyframes shine{to{background-position:200% center}}
.welcome p.sub{
  color:var(--text-dim);font-size:clamp(1rem,3.4vw,1.2rem);margin-bottom:34px;
  opacity:0;animation:fadeUp .9s ease 1.6s forwards;
}
.welcome .btn{opacity:0;animation:fadeUp .9s ease 2s forwards}

/* =========================================================
   BUTTONS
   ========================================================= */
.btn{
  position:relative;display:inline-flex;align-items:center;justify-content:center;gap:.5em;
  padding:.95em 1.8em;min-height:48px;border-radius:999px;font-weight:700;letter-spacing:.02em;
  font-size:clamp(.95rem,3.4vw,1.05rem);
  color:#2a1a00;background:linear-gradient(135deg,#ffe29a,var(--gold) 55%,var(--gold-deep));
  box-shadow:0 10px 30px rgba(245,199,107,.35),inset 0 1px 0 rgba(255,255,255,.6);
  transition:transform .25s ease,box-shadow .25s ease,filter .25s ease;
  touch-action:manipulation;
}
.btn:hover{transform:translateY(-3px);box-shadow:0 16px 40px rgba(245,199,107,.5)}
.btn:active{transform:translateY(0) scale(.98)}
.btn.pulse{animation:fadeUp .9s ease 2s forwards,pulseGlow 2.4s ease-in-out 3s infinite}
@keyframes pulseGlow{0%,100%{box-shadow:0 10px 30px rgba(245,199,107,.35)}50%{box-shadow:0 10px 50px rgba(255,79,163,.6)}}
.btn.ghost{
  color:var(--text);background:var(--glass);border:1px solid var(--glass-border);
  backdrop-filter:blur(10px);-webkit-backdrop-filter:blur(10px);box-shadow:none;
}
.btn.ghost:hover{background:rgba(255,255,255,.14);box-shadow:0 10px 30px rgba(124,58,237,.35)}
.btn.pink{color:#fff;background:linear-gradient(135deg,var(--pink),var(--purple));box-shadow:0 10px 30px rgba(255,79,163,.4)}
.btn.pink:hover{box-shadow:0 16px 40px rgba(255,79,163,.55)}

/* =========================================================
   MUSIC TOGGLE + TOAST
   ========================================================= */
.music{
  position:fixed;top:max(14px,env(safe-area-inset-top));right:14px;z-index:70;
  width:48px;height:48px;border-radius:50%;font-size:1.25rem;
  display:grid;place-items:center;
  background:rgba(20,26,74,.7);border:1px solid var(--glass-border);
  backdrop-filter:blur(10px);-webkit-backdrop-filter:blur(10px);
  box-shadow:var(--shadow);transition:transform .2s ease,background .2s;
}
.music:hover{transform:scale(1.08)}
.music[aria-pressed="true"]{background:linear-gradient(135deg,var(--pink),var(--purple))}
.toast{
  position:fixed;left:50%;bottom:max(24px,env(safe-area-inset-bottom));z-index:80;
  transform:translate(-50%,30px);opacity:0;visibility:hidden;
  width:min(92vw,460px);padding:14px 18px;border-radius:16px;text-align:center;font-size:.95rem;
  background:rgba(14,18,56,.95);border:1px solid rgba(245,199,107,.5);color:var(--text);
  box-shadow:var(--shadow);transition:all .4s ease;
}
.toast.show{transform:translate(-50%,0);opacity:1;visibility:visible}

/* =========================================================
   MAIN LAYOUT
   ========================================================= */
main{position:relative;z-index:5;opacity:0;transition:opacity 1s ease}
main.visible{opacity:1}
section{padding:clamp(56px,10vw,110px) 20px;display:flex;justify-content:center}
.wrap{width:100%;max-width:880px}
.section-title{
  text-align:center;font-family:var(--serif);font-size:clamp(1.7rem,6vw,2.8rem);
  margin-bottom:10px;color:#fff;
}
.section-title span{color:var(--gold)}
.section-sub{text-align:center;color:var(--text-dim);margin-bottom:36px}
.card{
  position:relative;border-radius:28px;padding:clamp(22px,5vw,48px);
  background:var(--glass);border:1px solid var(--glass-border);
  backdrop-filter:blur(16px);-webkit-backdrop-filter:blur(16px);
  box-shadow:var(--shadow);
}

/* Scroll reveal */
.reveal{opacity:0;transform:translateY(40px);transition:opacity .9s ease,transform .9s cubic-bezier(.2,.8,.2,1)}
.reveal.in{opacity:1;transform:none}
@keyframes fadeUp{from{opacity:0;transform:translateY(26px)}to{opacity:1;transform:none}}

/* =========================================================
   LETTER
   ========================================================= */
.letter{
  background:
    linear-gradient(160deg,rgba(255,255,255,.1),rgba(255,255,255,.04)),
    rgba(20,26,74,.55);
  border:1px solid rgba(245,199,107,.35);
}
.letter::before{ /* gold glow edge */
  content:"";position:absolute;inset:-1px;border-radius:inherit;pointer-events:none;
  box-shadow:0 0 60px rgba(245,199,107,.12) inset;
}
.letter .seal{
  position:absolute;top:-22px;left:50%;transform:translateX(-50%);
  width:48px;height:48px;border-radius:50%;display:grid;place-items:center;font-size:1.4rem;
  background:radial-gradient(circle at 30% 30%,#ff9ccf,var(--pink) 60%,#b3206a);
  box-shadow:0 8px 24px rgba(255,79,163,.55);
}
.letter h2{
  font-family:var(--script);font-weight:400;color:var(--gold);
  font-size:clamp(1.9rem,6vw,2.6rem);margin:8px 0 18px;
}
.letter p{
  font-family:var(--serif);font-size:clamp(1.02rem,3.4vw,1.2rem);line-height:1.85;margin-bottom:1.1em;color:#f1ecff;
}
.letter .line{opacity:0;transform:translateY(18px);transition:opacity .8s ease,transform .8s ease}
.letter.in .line{opacity:1;transform:none;transition-delay:calc(var(--i)*.22s + .2s)}
.letter .sign{margin-top:1.6em;color:var(--pink-soft)}
.letter-actions{display:flex;flex-wrap:wrap;gap:12px;justify-content:center;margin-top:28px}

/* =========================================================
   CELEBRATION / COUNTDOWN CARD
   ========================================================= */
.celebrate{text-align:center;overflow:hidden}
.celebrate .big{font-size:clamp(2.6rem,10vw,4rem);display:block;animation:bob 3s ease-in-out infinite}
.celebrate h2{
  font-family:var(--serif);font-size:clamp(1.6rem,6vw,2.6rem);margin:10px 0;
  background:linear-gradient(90deg,var(--gold),var(--pink-soft),var(--purple-soft));
  -webkit-background-clip:text;background-clip:text;-webkit-text-fill-color:transparent;color:transparent;
}
.celebrate p{color:var(--text-dim);max-width:520px;margin:0 auto}
@keyframes bob{0%,100%{transform:translateY(0) rotate(-4deg)}50%{transform:translateY(-10px) rotate(4deg)}}

/* =========================================================
   CAKE
   ========================================================= */
.cake-stage{display:flex;flex-direction:column;align-items:center;text-align:center}
.cake{
  position:relative;display:flex;flex-direction:column;align-items:center;
  margin:30px 0 26px;filter:drop-shadow(0 25px 30px rgba(0,0,0,.45));
  transform:scale(var(--k,1));transform-origin:top center;
}
.candles{display:flex;gap:26px;margin-bottom:-2px;position:relative;z-index:3}
.candle{
  position:relative;width:12px;height:50px;border-radius:4px;
  background:repeating-linear-gradient(135deg,#fff 0 8px,var(--pink) 8px 16px);
  box-shadow:0 0 0 1px rgba(0,0,0,.1);
}
.candle::before{ /* wick */
  content:"";position:absolute;left:50%;top:-6px;width:2px;height:8px;background:#3b2a1a;transform:translateX(-50%);
}
.flame{
  position:absolute;left:50%;top:-34px;width:16px;height:30px;transform:translateX(-50%);transform-origin:50% 90%;
  background:radial-gradient(ellipse at 50% 75%,#fff6c9 0 20%,#ffd54a 45%,#ff8a1f 80%,transparent 100%);
  border-radius:50% 50% 50% 50%/65% 65% 35% 35%;
  box-shadow:0 0 18px 6px rgba(255,190,70,.65),0 0 46px 14px rgba(255,140,40,.35);
  animation:flicker .18s ease-in-out infinite alternate,sway 2.2s ease-in-out infinite;
  transition:opacity .35s ease,transform .35s ease;
}
.candle:nth-child(2) .flame{animation-delay:.06s,.4s}
.candle:nth-child(3) .flame{animation-delay:.11s,.9s}
@keyframes flicker{from{transform:translateX(-50%) scale(1,1)}to{transform:translateX(-50%) scale(.92,1.08)}}
@keyframes sway{0%,100%{margin-left:-1px}50%{margin-left:2px}}
.cake.blown .flame{opacity:0;animation:none;transform:translateX(-50%) scale(.2);box-shadow:none}
.smoke{
  position:absolute;left:50%;top:-30px;width:10px;height:10px;border-radius:50%;
  background:rgba(255,255,255,.45);filter:blur(4px);opacity:0;pointer-events:none;
}
.cake.blown .smoke{animation:smoke 2s ease-out forwards}
.cake.blown .candle:nth-child(2) .smoke{animation-delay:.12s}
.cake.blown .candle:nth-child(3) .smoke{animation-delay:.24s}
@keyframes smoke{0%{opacity:.7;transform:translate(-50%,0) scale(.6)}100%{opacity:0;transform:translate(-30%,-70px) scale(2.6)}}

.tier{position:relative;border-radius:16px 16px 10px 10px;box-shadow:inset 0 -10px 18px rgba(0,0,0,.18)}
.tier::before{ /* icing cap */
  content:"";position:absolute;left:0;right:0;top:0;height:16px;border-radius:16px 16px 6px 6px;background:#fff;
}
.tier::after{ /* icing drips */
  content:"";position:absolute;left:0;right:0;top:10px;height:26px;
  background:radial-gradient(circle at 14px 0,#fff 11px,transparent 12px) 0 0/28px 26px repeat-x;
}
.t3{width:96px;height:46px;background:linear-gradient(180deg,#ff9ccf,var(--pink));z-index:2}
.t2{width:158px;height:54px;background:linear-gradient(180deg,#c4a8ff,var(--purple));margin-top:-4px;z-index:1}
.t1{width:220px;height:62px;background:linear-gradient(180deg,#ffe29a,var(--gold-deep));margin-top:-4px}
.plate{width:260px;height:14px;border-radius:50%;margin-top:-2px;background:linear-gradient(180deg,#e9e4ff,#9c93c9);box-shadow:0 8px 20px rgba(0,0,0,.4)}
.sprinkle{position:absolute;width:6px;height:6px;border-radius:50%;z-index:2}

.wish-msg{
  min-height:3.4em;max-width:520px;margin-top:22px;font-family:var(--serif);font-size:clamp(1.05rem,3.6vw,1.3rem);
  color:var(--gold);opacity:0;transform:translateY(14px);transition:all .7s ease;
}
.wish-msg.show{opacity:1;transform:none}

/* =========================================================
   GALLERY
   ========================================================= */
.grid{display:grid;grid-template-columns:repeat(2,1fr);gap:16px}
@media(min-width:760px){.grid{grid-template-columns:repeat(4,1fr);gap:20px}}
.tile{
  position:relative;overflow:hidden;border-radius:24px;padding:26px 14px 22px;text-align:center;
  background:var(--glass);border:1px solid var(--glass-border);
  backdrop-filter:blur(12px);-webkit-backdrop-filter:blur(12px);
  box-shadow:var(--shadow);transition:transform .4s ease,box-shadow .4s ease,border-color .4s;
}
.tile::before{ /* decorative glow blob */
  content:"";position:absolute;width:160px;height:160px;border-radius:50%;left:50%;top:-50px;transform:translateX(-50%);
  background:radial-gradient(circle,var(--g1),transparent 65%);opacity:.55;transition:opacity .4s;
}
.tile:hover{transform:translateY(-8px) rotate(-1.5deg);border-color:rgba(245,199,107,.6);box-shadow:0 24px 60px rgba(124,58,237,.4)}
.tile:hover::before{opacity:.9}
.tile .emo{position:relative;display:block;font-size:clamp(2.6rem,9vw,3.6rem);margin-bottom:10px;animation:bob 4s ease-in-out infinite}
.tile:nth-child(2) .emo{animation-delay:.5s}
.tile:nth-child(3) .emo{animation-delay:1s}
.tile:nth-child(4) .emo{animation-delay:1.5s}
.tile h3{position:relative;font-family:var(--serif);font-size:clamp(1rem,3.6vw,1.2rem);color:#fff}
.tile p{position:relative;font-size:.85rem;color:var(--text-dim);margin-top:4px}
.tile:nth-child(1){--g1:rgba(255,79,163,.8)}
.tile:nth-child(2){--g1:rgba(124,58,237,.9)}
.tile:nth-child(3){--g1:rgba(245,199,107,.8)}
.tile:nth-child(4){--g1:rgba(80,200,255,.7)}

/* =========================================================
   FINAL WISH
   ========================================================= */
.final{text-align:center;padding-bottom:clamp(80px,14vw,140px)}
.final .crown{font-size:clamp(2.4rem,9vw,3.6rem);display:block;margin-bottom:6px;animation:bob 3s ease-in-out infinite}
.final h2{
  font-family:var(--serif);font-weight:700;line-height:1.15;
  font-size:clamp(2.1rem,8.5vw,4.6rem);margin-bottom:32px;
  background:linear-gradient(100deg,var(--gold),#fff,var(--pink),var(--purple-soft),var(--gold));
  background-size:300% auto;-webkit-background-clip:text;background-clip:text;
  -webkit-text-fill-color:transparent;color:transparent;
  animation:shine 7s linear infinite,glowPulse 3s ease-in-out infinite;
}
@keyframes glowPulse{
  0%,100%{filter:drop-shadow(0 0 10px rgba(245,199,107,.35))}
  50%{filter:drop-shadow(0 0 28px rgba(255,79,163,.7))}
}
.final .actions{display:flex;flex-wrap:wrap;gap:12px;justify-content:center}
footer{position:relative;z-index:5;text-align:center;padding:0 20px 40px;color:var(--text-dim);font-size:.9rem}

/* =========================================================
   RESPONSIVE TWEAKS
   ========================================================= */
@media(max-width:480px){
  .cake{--k:.85}
  .btn{width:100%;max-width:340px}
  .letter-actions,.final .actions{flex-direction:column;align-items:center}
}

/* =========================================================
   REDUCED MOTION
   ========================================================= */
@media (prefers-reduced-motion:reduce){
  html{scroll-behavior:auto}
  *,*::before,*::after{
    animation-duration:.001ms !important;animation-iteration-count:1 !important;
    animation-delay:0s !important;transition-duration:.001ms !important;transition-delay:0s !important;
  }
  .balloon,.heart{display:none}
  .welcome h1 .ch,.eyebrow,.welcome p.sub,.welcome .btn{opacity:1;transform:none}
  .reveal,.letter .line,.wish-msg.show{opacity:1;transform:none}
}
</style>
</head>
<body class="locked">

<!-- Decorative background layers -->
<div id="stars" class="fx" aria-hidden="true"></div>
<div id="balloons" class="fx" aria-hidden="true"></div>
<div id="hearts" class="fx" aria-hidden="true"></div>
<canvas id="confetti" aria-hidden="true"></canvas>

<!-- Music toggle -->
<button class="music" id="musicBtn" type="button" aria-pressed="false" aria-label="Toggle background music" title="Toggle music">🎵</button>
<audio id="bgm" loop preload="none"></audio>

<!-- Toast notifications -->
<div class="toast" id="toast" role="status" aria-live="polite"></div>

<!-- ================= 1. WELCOME SCREEN ================= -->
<div class="welcome" id="welcome">
  <div class="welcome-inner">
    <span class="eyebrow">A Special Day for Someone Special</span>
    <h1 id="welcomeTitle" aria-label="Happy Birthday, Aman Kamti!">Happy Birthday, Aman Kamti!</h1>
    <p class="sub">A little surprise has been wrapped up just for you. ✨</p>
    <button class="btn pulse" id="openBtn" type="button">Open Your Birthday Surprise 🎁</button>
  </div>
</div>

<main id="main" hidden>

  <!-- ================= 2. PERSONAL BIRTHDAY LETTER ================= -->
  <section id="letterSection" aria-labelledby="letterHeading">
    <div class="wrap">
      <article class="card letter reveal" id="letter">
        <div class="seal" aria-hidden="true">💌</div>
        <h2 id="letterHeading" tabindex="-1">Dear Aman Kamti,</h2>
        <p class="line" style="--i:0">Happy Birthday to you! 🎂🎉</p>
        <p class="line" style="--i:1">May your special day be filled with happiness, laughter, love, and unforgettable memories. May every new day bring you new opportunities, success, confidence, and countless reasons to smile.</p>
        <p class="line" style="--i:2">May your dreams grow bigger, your journey become brighter, and your life be filled with wonderful experiences. Keep smiling, keep believing in yourself, and always move forward with courage and positivity.</p>
        <p class="line" style="--i:3">Wishing you good health, endless happiness, success in everything you do, and a fantastic year ahead.</p>
        <p class="line" style="--i:4">Have an amazing birthday, Aman! May your day be as special as you are.</p>
        <p class="line sign" style="--i:5">With warm wishes,<br>Happy Birthday! 🎂✨</p>
        <div class="letter-actions">
          <button class="btn ghost" type="button" data-copy aria-label="Copy the birthday wishes to the clipboard">📋 Copy Birthday Wishes</button>
        </div>
      </article>
    </div>
  </section>

  <!-- ================= 3. TODAY'S CELEBRATION (no invented age/date) ================= -->
  <section aria-labelledby="todayHeading">
    <div class="wrap">
      <div class="card celebrate reveal">
        <span class="big" aria-hidden="true">🎈</span>
        <h2 id="todayHeading">Today is your special celebration!</h2>
        <p>No countdown needed. This day is all about you, your smile, and everything wonderful ahead.</p>
      </div>
    </div>
  </section>

  <!-- ================= 4. INTERACTIVE CAKE ================= -->
  <section aria-labelledby="cakeHeading">
    <div class="wrap">
      <h2 class="section-title reveal" id="cakeHeading">Make a <span>Wish</span></h2>
      <p class="section-sub reveal">Close your eyes, think of something wonderful, then blow out the candles.</p>
      <div class="cake-stage reveal">
        <div class="cake" id="cake" role="img" aria-label="A birthday cake with three glowing candles">
          <div class="candles">
            <div class="candle"><i class="flame"></i><i class="smoke"></i></div>
            <div class="candle"><i class="flame"></i><i class="smoke"></i></div>
            <div class="candle"><i class="flame"></i><i class="smoke"></i></div>
          </div>
          <div class="tier t3"></div>
          <div class="tier t2"></div>
          <div class="tier t1"></div>
          <div class="plate"></div>
        </div>
        <button class="btn pink" id="wishBtn" type="button">Make a Wish 🎂</button>
        <p class="wish-msg" id="wishMsg" role="status" aria-live="polite"></p>
      </div>
    </div>
  </section>

  <!-- ================= 5. SURPRISE GALLERY ================= -->
  <section aria-labelledby="galleryHeading">
    <div class="wrap">
      <h2 class="section-title reveal" id="galleryHeading">Surprise <span>Gallery</span></h2>
      <p class="section-sub reveal">A few little things wrapped up just for you.</p>
      <div class="grid">
        <figure class="tile reveal"><span class="emo" aria-hidden="true">😊</span><h3>Happiness</h3><p>Smiles that never fade</p></figure>
        <figure class="tile reveal"><span class="emo" aria-hidden="true">🤝</span><h3>Friendship</h3><p>Moments that matter</p></figure>
        <figure class="tile reveal"><span class="emo" aria-hidden="true">🚀</span><h3>Dream Big</h3><p>The sky is only the start</p></figure>
        <figure class="tile reveal"><span class="emo" aria-hidden="true">📸</span><h3>Wonderful Memories</h3><p>Treasured forever</p></figure>
      </div>
    </div>
  </section>

  <!-- ================= 6. FINAL WISH ================= -->
  <section class="final" id="finalSection" aria-labelledby="finalHeading">
    <div class="wrap">
      <span class="crown reveal" aria-hidden="true">👑</span>
      <h2 id="finalHeading" class="reveal">Once Again, Happy Birthday Aman Kamti!</h2>
      <div class="actions reveal">
        <button class="btn pink" id="replayBtn" type="button">🎉 Replay the Celebration</button>
        <button class="btn ghost" type="button" data-copy aria-label="Copy the birthday wishes to the clipboard">📋 Copy Birthday Wishes</button>
      </div>
    </div>
  </section>

  <footer>Made with 💜 for Aman Kamti</footer>
</main>

<script>
/* =========================================================
   BIRTHDAY WEBSITE SCRIPT (vanilla JS, no libraries)
   ========================================================= */
(() => {
  'use strict';

  /* ---------- Helpers ---------- */
  const $  = (s, c = document) => c.querySelector(s);
  const $$ = (s, c = document) => Array.from(c.querySelectorAll(s));
  const rand = (a, b) => a + Math.random() * (b - a);
  const pick = arr => arr[Math.floor(Math.random() * arr.length)];
  const motionQuery = window.matchMedia('(prefers-reduced-motion: reduce)');
  const reduced = () => motionQuery.matches;
  const isSmall = () => window.innerWidth < 640;

  /* ---------- Birthday text used by the copy button ---------- */
  const WISHES = [
    'Dear Aman Kamti,',
    '',
    'Happy Birthday to you! 🎂🎉',
    '',
    'May your special day be filled with happiness, laughter, love, and unforgettable memories. May every new day bring you new opportunities, success, confidence, and countless reasons to smile.',
    '',
    'May your dreams grow bigger, your journey become brighter, and your life be filled with wonderful experiences. Keep smiling, keep believing in yourself, and always move forward with courage and positivity.',
    '',
    'Wishing you good health, endless happiness, success in everything you do, and a fantastic year ahead.',
    '',
    'Have an amazing birthday, Aman! May your day be as special as you are.',
    '',
    'With warm wishes,',
    'Happy Birthday! 🎂✨'
  ].join('\n');

  /* ---------- Toast ---------- */
  const toastEl = $('#toast');
  let toastTimer = null;
  function toast(msg, ms = 3800) {
    toastEl.textContent = msg;
    toastEl.classList.add('show');
    clearTimeout(toastTimer);
    toastTimer = setTimeout(() => toastEl.classList.remove('show'), ms);
  }

  /* =========================================================
     BACKGROUND DECORATIONS
     ========================================================= */
  function buildStars() {
    const box = $('#stars');
    const n = isSmall() ? 40 : 80;
    const frag = document.createDocumentFragment();
    for (let i = 0; i < n; i++) {
      const s = document.createElement('i');
      s.className = 'star';
      s.style.setProperty('--x', rand(0, 100).toFixed(1) + '%');
      s.style.setProperty('--y', rand(0, 100).toFixed(1) + '%');
      s.style.setProperty('--s', rand(1.5, 3.5).toFixed(1) + 'px');
      s.style.setProperty('--t', rand(2.5, 6).toFixed(1) + 's');
      s.style.setProperty('--d', (-rand(0, 6)).toFixed(1) + 's');
      frag.appendChild(s);
    }
    box.appendChild(frag);
  }

  function buildBalloons() {
    const box = $('#balloons');
    const colors = ['#ff4fa3', '#7c3aed', '#f5c76b', '#a78bfa', '#ff7ab8', '#5b8cff'];
    const n = isSmall() ? 7 : 12;
    const frag = document.createDocumentFragment();
    for (let i = 0; i < n; i++) {
      const b = document.createElement('div');
      b.className = 'balloon';
      b.style.setProperty('--x', rand(2, 92).toFixed(1) + '%');
      b.style.setProperty('--s', rand(46, 78).toFixed(0) + 'px');
      b.style.setProperty('--c', pick(colors));
      b.style.setProperty('--t', rand(16, 28).toFixed(1) + 's');
      b.style.setProperty('--d', (-rand(0, 24)).toFixed(1) + 's');
      frag.appendChild(b);
    }
    box.appendChild(frag);
  }

  function buildHearts() {
    const box = $('#hearts');
    const symbols = ['💖', '💜', '💗', '✨'];
    const n = isSmall() ? 5 : 8;
    const frag = document.createDocumentFragment();
    for (let i = 0; i < n; i++) {
      const h = document.createElement('span');
      h.className = 'heart';
      h.textContent = pick(symbols);
      h.style.setProperty('--x', rand(3, 95).toFixed(1) + '%');
      h.style.setProperty('--s', rand(14, 26).toFixed(0) + 'px');
      h.style.setProperty('--t', rand(12, 20).toFixed(1) + 's');
      h.style.setProperty('--d', (-rand(0, 18)).toFixed(1) + 's');
      frag.appendChild(h);
    }
    box.appendChild(frag);
  }

  /* Split welcome title into animated characters */
  function splitTitle() {
    const h = $('#welcomeTitle');
    const text = h.textContent;
    h.textContent = '';
    let i = 0;
    text.split('').forEach(ch => {
      const s = document.createElement('span');
      s.setAttribute('aria-hidden', 'true');
      if (ch === ' ') { s.className = 'sp'; }
      else { s.className = 'ch'; s.textContent = ch; s.style.setProperty('--i', i++); }
      h.appendChild(s);
    });
  }

  /* Decorate the cake with a few sprinkles (pure CSS elements) */
  function sprinkleCake() {
    const cols = ['#ff4fa3', '#7c3aed', '#f5c76b', '#5b8cff', '#fff'];
    [['.t1', 7], ['.t2', 5], ['.t3', 3]].forEach(([sel, n]) => {
      const tier = $(sel);
      if (!tier) return;
      for (let i = 0; i < n; i++) {
        const d = document.createElement('i');
        d.className = 'sprinkle';
        d.style.left = rand(8, 90).toFixed(0) + '%';
        d.style.top = rand(46, 80).toFixed(0) + '%';
        d.style.background = pick(cols);
        tier.appendChild(d);
      }
    });
  }

  /* =========================================================
     CONFETTI (canvas, capped for mobile performance)
     ========================================================= */
  const canvas = $('#confetti');
  const ctx = canvas.getContext('2d');
  let W = 0, H = 0, parts = [], raf = null;
  const COLORS = ['#ff4fa3', '#f5c76b', '#7c3aed', '#a78bfa', '#ffffff', '#5b8cff', '#ff9ccf'];

  function resizeCanvas() {
    const dpr = Math.min(window.devicePixelRatio || 1, 2);
    W = window.innerWidth; H = window.innerHeight;
    canvas.width = Math.floor(W * dpr);
    canvas.height = Math.floor(H * dpr);
    ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
  }

  function burst(count = 140, x = W / 2, y = H * 0.4, spread = 1) {
    if (reduced()) return;
    count = Math.min(count, isSmall() ? 90 : 180);
    for (let i = 0; i < count; i++) {
      parts.push({
        x, y,
        vx: rand(-9, 9) * spread,
        vy: rand(-15, -4),
        w: rand(6, 11), h: rand(8, 14),
        r: rand(0, 6.28), vr: rand(-0.3, 0.3),
        c: pick(COLORS),
        round: Math.random() < 0.25,
        life: 0, max: rand(110, 190)
      });
    }
    if (parts.length > 400) parts.splice(0, parts.length - 400);
    if (!raf) raf = requestAnimationFrame(tick);
  }

  function rain(waves = 4) {
    if (reduced()) return;
    for (let i = 0; i < waves; i++) {
      setTimeout(() => burst(60, rand(W * 0.1, W * 0.9), rand(H * 0.05, H * 0.3), 0.7), i * 280);
    }
  }

  function tick() {
    ctx.clearRect(0, 0, W, H);
    parts = parts.filter(p => p.life < p.max && p.y < H + 30);
    for (const p of parts) {
      p.vy += 0.3; p.vx *= 0.99;
      p.x += p.vx; p.y += p.vy; p.r += p.vr; p.life++;
      ctx.save();
      ctx.globalAlpha = Math.max(0, 1 - p.life / p.max);
      ctx.translate(p.x, p.y);
      ctx.rotate(p.r);
      ctx.fillStyle = p.c;
      if (p.round) { ctx.beginPath(); ctx.arc(0, 0, p.w / 2, 0, 6.28); ctx.fill(); }
      else { ctx.fillRect(-p.w / 2, -p.h / 2, p.w, p.h); }
      ctx.restore();
    }
    if (parts.length) { raf = requestAnimationFrame(tick); }
    else { raf = null; ctx.clearRect(0, 0, W, H); }
  }

  /* =========================================================
     SCROLL REVEAL
     ========================================================= */
  let io = null;
  let finalFired = false;

  function setupReveal() {
    const items = $$('.reveal');
    if (!('IntersectionObserver' in window)) { items.forEach(el => el.classList.add('in')); return; }
    io = new IntersectionObserver(entries => {
      entries.forEach(e => {
        if (!e.isIntersecting) return;
        e.target.classList.add('in');
        io.unobserve(e.target);
        if (e.target.id === 'finalHeading' && !finalFired) {
          finalFired = true;
          burst(160, W / 2, H * 0.5);
          rain(3);
        }
      });
    }, { threshold: 0.2 });
    items.forEach(el => io.observe(el));
  }

  /* =========================================================
     OPEN SURPRISE
     ========================================================= */
  const welcome = $('#welcome');
  const main = $('#main');
  const openBtn = $('#openBtn');

  function openSurprise() {
    openBtn.disabled = true;
    welcome.classList.add('leaving');
    main.hidden = false;
    document.body.classList.remove('locked');
    window.scrollTo(0, 0);
    requestAnimationFrame(() => main.classList.add('visible'));
    setupReveal();
    burst(200, W / 2, H * 0.45);
    setTimeout(() => burst(120, W * 0.2, H * 0.5), 350);
    setTimeout(() => burst(120, W * 0.8, H * 0.5), 600);
    setTimeout(() => { welcome.style.display = 'none'; const h = $('#letterHeading'); if (h) h.focus({ preventScroll: true }); }, 900);
  }
  openBtn.addEventListener('click', openSurprise);

  /* =========================================================
     CAKE: MAKE A WISH
     ========================================================= */
  const cake = $('#cake');
  const wishBtn = $('#wishBtn');
  const wishMsg = $('#wishMsg');
  const WISH_TEXT = '🎉 Wish made, Aman! May every single wish come true. 🎉';

  function blowCandles() {
    cake.classList.add('blown');
    wishMsg.textContent = WISH_TEXT;
    wishMsg.classList.add('show');
    wishBtn.textContent = 'Light the Candles Again 🕯️';
    wishBtn.dataset.state = 'blown';
    const r = cake.getBoundingClientRect();
    burst(150, r.left + r.width / 2, r.top + 20);
  }
  function relightCandles() {
    cake.classList.remove('blown');
    wishMsg.classList.remove('show');
    wishMsg.textContent = '';
    wishBtn.textContent = 'Make a Wish 🎂';
    wishBtn.dataset.state = '';
  }
  wishBtn.addEventListener('click', () => {
    if (wishBtn.dataset.state === 'blown') relightCandles(); else blowCandles();
  });

  /* =========================================================
     COPY WISHES (Clipboard API + fallback)
     ========================================================= */
  async function copyWishes() {
    try {
      if (navigator.clipboard && window.isSecureContext) {
        await navigator.clipboard.writeText(WISHES);
      } else {
        throw new Error('fallback');
      }
      toast('Birthday wishes copied to clipboard! 💌');
    } catch (e) {
      try {
        const ta = document.createElement('textarea');
        ta.value = WISHES;
        ta.setAttribute('readonly', '');
        ta.style.cssText = 'position:fixed;top:0;left:0;opacity:0;';
        document.body.appendChild(ta);
        ta.select();
        ta.setSelectionRange(0, ta.value.length);
        const ok = document.execCommand('copy');
        document.body.removeChild(ta);
        toast(ok ? 'Birthday wishes copied to clipboard! 💌' : 'Copy failed. Please select the text and copy it manually.');
      } catch (err) {
        toast('Copy failed. Please select the text and copy it manually.');
      }
    }
  }
  $$('[data-copy]').forEach(b => b.addEventListener('click', copyWishes));

  /* =========================================================
     REPLAY CELEBRATION
     ========================================================= */
  function replay() {
    relightCandles();
    finalFired = true; // we fire confetti manually below
    window.scrollTo({ top: 0, behavior: reduced() ? 'auto' : 'smooth' });
    // Restart reveal animations
    $$('.reveal').forEach(el => { el.classList.remove('in'); });
    void main.offsetWidth; // force reflow so transitions restart
    if (io) { io.disconnect(); }
    finalFired = false;
    setupReveal();
    burst(200, W / 2, H * 0.4);
    setTimeout(() => burst(120, W * 0.15, H * 0.5), 300);
    setTimeout(() => burst(120, W * 0.85, H * 0.5), 550);
    toast('Let the celebration begin again! 🎊', 2600);
  }
  $('#replayBtn').addEventListener('click', replay);

  /* =========================================================
     MUSIC TOGGLE (never autoplays)
     ========================================================= */
  const musicBtn = $('#musicBtn');
  const audio = $('#bgm');
  const AUDIO_FILE = 'music.mp3';
  const NO_AUDIO_MSG = 'Music needs an audio file. Save one named "music.mp3" next to index.html, then tap the music button again. 🎵';
  let musicOn = false;

  function setMusicUI(on) {
    musicOn = on;
    musicBtn.setAttribute('aria-pressed', String(on));
    musicBtn.textContent = on ? '🔊' : '🎵';
    musicBtn.setAttribute('aria-label', on ? 'Pause background music' : 'Play background music');
  }

  musicBtn.addEventListener('click', async () => {
    if (musicOn) { audio.pause(); setMusicUI(false); return; }
    try {
      if (!audio.getAttribute('src')) audio.src = AUDIO_FILE; // load only on request
      await audio.play();
      setMusicUI(true);
      toast('Music playing 🎶', 1800);
    } catch (err) {
      audio.removeAttribute('src');
      setMusicUI(false);
      toast(NO_AUDIO_MSG, 6000);
    }
  });
  audio.addEventListener('error', () => {
    if (!audio.getAttribute('src')) return;
    audio.removeAttribute('src');
    setMusicUI(false);
    toast(NO_AUDIO_MSG, 6000);
  });

  /* =========================================================
     INIT
     ========================================================= */
  let resizeTimer = null;
  window.addEventListener('resize', () => {
    clearTimeout(resizeTimer);
    resizeTimer = setTimeout(resizeCanvas, 150);
  });

  resizeCanvas();
  buildStars();
  buildBalloons();
  buildHearts();
  splitTitle();
  sprinkleCake();
  setMusicUI(false);
})();
</script>
</body>
</html>
